{
  "expo": {
    "name": "TinkerBlink",
    "slug": "tinkerblink",
    "scheme": "tinkerblink",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "app.tinkerblink",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#12202A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "backgroundColor": "#EEF2F0",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#12202A"
          }
        }
      ],
      "expo-video",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Shows your position on the Map widget.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      "./plugins/withShortCxxPath",
      "./plugins/withNetworkSecurityConfig",
      "./plugins/withAbiSplits",
      "./plugins/withGradleTuning",
      "./plugins/withoutLocationService"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
